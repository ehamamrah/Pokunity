# Server-side only: where the BFF proxy forwards /api/v1/* (read at runtime).
BACKEND_INTERNAL_URL=http://localhost:4000

# Browser-side API base used by the client (the BFF on the same origin).
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Dev-only: start the MSW mock backend in the browser. Off by default.
NEXT_PUBLIC_API_MOCKING=disabled

# Set to "true" to force Secure cookies (otherwise derived from the request protocol).
# COOKIE_SECURE=false
