{
  "name": "pokunity-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Pokunity marketplace web app (Next.js App Router + BFF proxy)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock:init": "msw init public --save",
    "check:bundle": "node scripts/check-bundle.mjs",
    "build:verified": "next build && node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "next": "15.5.29",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "^7.30.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "15.5.29",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
