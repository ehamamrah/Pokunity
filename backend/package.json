{
  "name": "pokunity-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Pokunity Jameya marketplace API (NestJS modular monolith)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "migrate": "node dist/cli/migrate.js",
    "seed": "node dist/cli/seed.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --config jest.config.js --selectProjects unit --maxWorkers=2",
    "test:integration": "jest --config jest.config.js --selectProjects integration --runInBand",
    "loadtest:contention": "node dist/cli/loadtest-contention.js",
    "bench": "node dist/cli/bench.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/schedule": "^6.1.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^11.2.11",
    "@types/autocannon": "^7.12.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.7",
    "typescript-eslint": "^8.73.0"
  }
}
